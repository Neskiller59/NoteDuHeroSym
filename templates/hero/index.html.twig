
{% extends 'base.html.twig' %}

{% block title %}Mes héros - RPG Heroes{% endblock %}

{% block body %}

<div class="rpg-container container mt-5">

    {# HEADER #}

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <h1 class="rpg-title">
            ⚔️ Mes héros
        </h1>

        <a href="{{ path('hero_new') }}" class="btn btn-warning">
            ➕ Créer un héros
        </a>

    </div>

    {# FLASH MESSAGES #}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show"
                 role="alert">

                {{ message }}

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Fermer">
                </button>

            </div>
        {% endfor %}
    {% endfor %}

    {# EMPTY STATE #}

    {% if heroes is empty %}

        <div class="rpg-empty text-center mt-5">

            <h3>Tu n'as pas encore de héros.</h3>

            <p class="mt-3">
                Crée ton premier aventurier et commence ton histoire !
            </p>

            <a href="{{ path('hero_new') }}" class="btn btn-warning mt-2">
                Créer mon premier héros
            </a>

        </div>

    {% else %}

        {# HERO CARDS #}

        <div class="row g-4">

            {% for hero in heroes %}

                <div class="col-md-6 col-lg-4">

                    <div class="card rpg-card h-100">

                        {# HERO IMAGE #}

                        {% if hero.photo %}
                            <img
                                src="{{ asset('uploads/' ~ hero.photo) }}"
                                class="card-img-top"
                                alt="Photo de {{ hero.name }}"
                                style="height: 220px; object-fit: cover;"
                            >
                        {% else %}
                            <div class="d-flex justify-content-center align-items-center bg-dark text-warning"
                                 style="height: 220px;">
                                <span class="fs-1">🧙</span>
                            </div>
                        {% endif %}

                        <div class="card-body d-flex flex-column">

                            {# HERO NAME #}

                            <h4 class="text-warning mb-3">
                                {{ hero.name }}
                            </h4>

                            {# UNIVERSE #}

                            <p class="mb-2">
                                <strong> Univers :</strong>
                                {{ hero.universe ?: 'Non renseigné' }}
                            </p>

                            {# ADDITIONAL INFORMATION #}

                            {% if hero.additionalInfo %}
                                <div class="mb-3">
                                    <strong> Informations :</strong>

                                    <p class="mt-1">
                                        {{ hero.additionalInfo|length > 150
                                            ? hero.additionalInfo|slice(0, 150) ~ '...'
                                            : hero.additionalInfo }}
                                    </p>
                                </div>
                            {% endif %}

                            {# ACTIONS #}

                            <div class="mt-auto pt-3">

                                {# MAIN ACTION #}

                                <a href="{{ path('hero_select', {'id': hero.id}) }}"
                                   class="btn btn-warning w-100">
                                    ⚔️ Sélectionner ce héros
                                </a>

                                {# SECONDARY ACTIONS #}

                                <div class="d-flex justify-content-end align-items-center gap-2 mt-3">

                                    <a href="{{ path('hero_edit', {'id': hero.id}) }}"
                                       class="btn btn-sm hero-action-edit"
                                       title="Modifier {{ hero.name }}">

                                        <i class="fa-solid fa-pen-to-square me-1"></i>
                                        Modifier

                                    </a>

                                    <form
                                        method="post"
                                        action="{{ path('hero_delete', {'id': hero.id}) }}"
                                        class="m-0"
                                        onsubmit="return confirm('Es-tu sûr de vouloir supprimer ce héros ? Cette action est irréversible.');"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete' ~ hero.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-sm hero-action-delete"
                                            title="Supprimer {{ hero.name }}"
                                        >
                                            <i class="fa-regular fa-trash-can me-1"></i>
                                            Supprimer
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            {% endfor %}

        </div>

    {% endif %}

</div>

<style>
    .hero-action-edit,
    .hero-action-delete {
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.03);
        padding: 5px 10px;
        font-size: 0.78rem;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .hero-action-edit {
        color: #c4c4c4;
    }

    .hero-action-edit:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.09);
        border-color: rgba(255, 255, 255, 0.25);
    }

    .hero-action-delete {
        color: #d98b8b;
    }

    .hero-action-delete:hover {
        color: #ffffff;
        background: rgba(180, 45, 45, 0.18);
        border-color: rgba(220, 80, 80, 0.4);
    }
</style>

{% endblock %}
